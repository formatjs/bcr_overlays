# Shared module overrides keep Protobuf and Chromium on the same patched ABI.
archive_override(
    module_name = "abseil-cpp",
    integrity = "sha256-FpL3fRc5us8/lDNxiLeFg88JurfkINLcbFYFpPhnhaE=",
    patch_strip = 1,
    patches = [
        "//:overlays/abseil-cpp/bcr/patches/0001-chromium-hardening.patch",
        "//:overlays/abseil-cpp/bcr/patches/0002-chromium-annotations.patch",
        "//:overlays/abseil-cpp/bcr/patches/0003-chromium-stacktrace-init.patch",
        "//build:abseil-overlay.patch",
    ],
    strip_prefix = "abseil-cpp-20250814.1",
    urls = ["https://github.com/abseil/abseil-cpp/releases/download/20250814.1/abseil-cpp-20250814.1.tar.gz"],
)

archive_override(
    module_name = "boringssl",
    integrity = "sha256-+Wcz/D3wPUGV22VtG3uMF0wz+V0FL4EfDsyPTk49szI=",
    patch_strip = 1,
    patches = [
        "//:overlays/boringssl/bcr/patches/chromium_pki.patch",
        "//build:boringssl-overlay.patch",
    ],
    strip_prefix = "boringssl-0.20251002.0",
    urls = ["https://github.com/google/boringssl/releases/download/0.20251002.0/boringssl-0.20251002.0.tar.gz"],
)

sources = use_extension("//build:dependencies.bzl", "chromium_dependencies")
use_repo(sources, "angle", "chromium", "chromium_angle", "chromium_anonymous_tokens", "chromium_catapult", "chromium_cdm_api", "chromium_cld3", "chromium_content_analysis_sdk", "chromium_crabbyavif", "chromium_cros_system_api", "chromium_dawn", "chromium_devtools_esbuild", "chromium_devtools_frontend", "chromium_dom_distiller_js", "chromium_egl_registry", "chromium_eigen3", "chromium_emoji_segmenter", "chromium_farmhash", "chromium_federated_compute", "chromium_ffmpeg", "chromium_fontconfig", "chromium_freetype", "chromium_gemmlowp", "chromium_harfbuzz", "chromium_icu", "chromium_ink", "chromium_ink_stroke_modeler", "chromium_jpeg", "chromium_kde_protocols", "chromium_leveldatabase", "chromium_libaddressinput", "chromium_libdrm", "chromium_libgav1", "chromium_libphonenumber", "chromium_libsrtp", "chromium_libsync", "chromium_libyuv", "chromium_material_color_utilities", "chromium_neon_2_sse", "chromium_opengl_registry", "chromium_openscreen", "chromium_ots", "chromium_pciutils", "chromium_pdfium", "chromium_platform_headers", "chromium_platform_runtime", "chromium_protobuf_javascript", "chromium_pthreadpool", "chromium_quiche", "chromium_readability", "chromium_ruy", "chromium_search_engines_data", "chromium_skia", "chromium_smhasher", "chromium_sqlite", "chromium_swiftshader", "chromium_tflite", "chromium_v8", "chromium_vma", "chromium_vulkan_loader", "chromium_vulkan_tools", "chromium_vulkan_utility", "chromium_vulkan_validation", "chromium_wayland_protocols", "chromium_webp", "chromium_webrtc", "chromium_wuffs", "chromium_xcomposite", "chromium_xdg_utils", "chromium_xnnpack", "chromium_xtst", "compact_enc_det", "dragonbox", "fp16", "ipcz", "linux-syscall-support", "nspr", "nss", "perfetto", "skia", "v8")

register_toolchains("@llvm//toolchain:all")

# Keep host tools on the default platform; let tests match the target ABI.
register_execution_platforms(
    "@platforms//host",
    "@llvm//platforms:linux_x86_64_gnu.2.31",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    extra_pip_args = ["--require-hashes"],
    hub_name = "v8_python_deps",
    python_version = "3.11",
    requirements_lock = "@v8//:bazel/requirements.txt",
)
use_repo(pip, "v8_python_deps")

chromium_rust = use_extension("//overlays/chromium/bcr/overlay/native/rust:extensions.bzl", "chromium_rust")
use_repo(chromium_rust, "chromium_rust_compiler")

register_toolchains("@chromium//native/rust:toolchain", "@chromium//native/rust:bindgen_toolchain", "@chromium//native/rust:cargo_toolchain")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.11.0")
use_repo(node, "nodejs_linux_amd64")

npm_sources = use_extension("//overlays/chromium/bcr/overlay/native:node_deps.bzl", "npm_sources")
use_repo(npm_sources, "chromium_node_modules")

