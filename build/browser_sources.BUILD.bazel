load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"]))

_HEADERS = glob(["**/*.h", "**/*.hpp", "**/*.inc"], exclude = @@HEADER_EXCLUDES@@, allow_empty = True)

cc_library(
    name = "headers",
    hdrs = _HEADERS,
    includes = [".", "include", "src", "cpp/src", "cpp/include", "browser/include"],
)

cc_library(
    name = "chromium_headers",
    hdrs = _HEADERS,
    include_prefix = "@@PREFIX@@",
    strip_include_prefix = "/",
    deps = [":headers"],
)
