diff --git a/BUILD.bazel b/BUILD.bazel
--- /dev/null
+++ b/BUILD.bazel
@@ -0,0 +1,141 @@
+load("@rules_nasm//nasm:defs.bzl", "nasm_library")
+load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
+
+package(default_visibility = ["//visibility:public"])
+
+_PRIVATE_HEADERS = glob([
+    "include/common/*.h",
+    "src/**/*.h",
+]) + [
+    "config.h",
+    "include/vcs_version.h",
+]
+
+_PUBLIC_HEADERS = glob(["include/dav1d/*.h"])
+
+_TEMPLATE_SOURCES = [
+    "src/cdef_apply_tmpl.c",
+    "src/cdef_tmpl.c",
+    "src/fg_apply_tmpl.c",
+    "src/filmgrain_tmpl.c",
+    "src/ipred_prepare_tmpl.c",
+    "src/ipred_tmpl.c",
+    "src/itx_tmpl.c",
+    "src/lf_apply_tmpl.c",
+    "src/loopfilter_tmpl.c",
+    "src/looprestoration_tmpl.c",
+    "src/lr_apply_tmpl.c",
+    "src/mc_tmpl.c",
+    "src/recon_tmpl.c",
+]
+
+[
+    cc_library(
+        name = "bitdepth_{}".format(bitdepth),
+        srcs = _TEMPLATE_SOURCES + _PRIVATE_HEADERS,
+        hdrs = _PUBLIC_HEADERS,
+        includes = [
+            ".",
+            "include",
+        ],
+        linkstatic = True,
+        local_defines = ["BITDEPTH={}".format(bitdepth)],
+        visibility = ["//visibility:private"],
+    )
+    for bitdepth in [
+        8,
+        16,
+    ]
+]
+
+cc_library(
+    name = "dav1d",
+    srcs = [
+        "src/cdf.c",
+        "src/cpu.c",
+        "src/ctx.c",
+        "src/data.c",
+        "src/decode.c",
+        "src/dequant_tables.c",
+        "src/getbits.c",
+        "src/intra_edge.c",
+        "src/itx_1d.c",
+        "src/lf_mask.c",
+        "src/lib.c",
+        "src/log.c",
+        "src/mem.c",
+        "src/msac.c",
+        "src/obu.c",
+        "src/pal.c",
+        "src/picture.c",
+        "src/qm.c",
+        "src/ref.c",
+        "src/refmvs.c",
+        "src/scan.c",
+        "src/tables.c",
+        "src/thread_task.c",
+        "src/warpmv.c",
+        "src/wedge.c",
+    ] + _PRIVATE_HEADERS + select({
+        ":linux_x86_64": ["src/x86/cpu.c", ":x86_asm"],
+        "//conditions:default": [],
+    }) + select({
+        "@platforms//os:windows": ["src/win32/thread.c"],
+        "//conditions:default": [],
+    }),
+    hdrs = _PUBLIC_HEADERS,
+    includes = [
+        ".",
+        "include",
+    ],
+    linkopts = select({
+        "@platforms//os:windows": [],
+        "//conditions:default": ["-pthread"],
+    }),
+    linkstatic = True,
+    deps = [
+        ":bitdepth_16",
+        ":bitdepth_8",
+    ],
+    alwayslink = True,
+)
+
+[
+    cc_test(
+        name = "{}_header_test".format(header.replace(".", "_")),
+        srcs = ["tests/header_test.c"],
+        copts = ["-DDAV1D_TEST_HEADER=\\\"dav1d/{}\\\"".format(header)],
+        deps = [":dav1d"],
+    )
+    for header in [
+        "common.h",
+        "data.h",
+        "dav1d.h",
+        "headers.h",
+        "picture.h",
+        "version.h",
+    ]
+]
+
+cc_test(
+    name = "decoder_test",
+    srcs = ["tests/decoder_test.c"],
+    deps = [":dav1d"],
+)
+
+config_setting(
+    name = "linux_x86_64",
+    constraint_values = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
+)
+
+nasm_library(
+    name = "x86_asm",
+    srcs = glob(["src/x86/*.asm"], exclude = ["src/x86/filmgrain_common.asm"]),
+    hdrs = glob(["src/**/*.asm"]) + ["config.asm"],
+    includes = ["src"],
+    preincs = ["config.asm"],
+    target_compatible_with = select({
+        ":linux_x86_64": [],
+        "//conditions:default": ["@platforms//:incompatible"],
+    }),
+)
diff --git a/MODULE.bazel b/MODULE.bazel
--- /dev/null
+++ b/MODULE.bazel
@@ -0,0 +1,10 @@
+module(
+    name = "dav1d",
+    version = "1.5.4",
+    bazel_compatibility = [">=7.2.1"],
+)
+
+bazel_dep(name = "platforms", version = "1.0.0")
+bazel_dep(name = "rules_cc", version = "0.2.18")
+
+bazel_dep(name = "rules_nasm", version = "0.5.0")
diff --git a/config.h b/config.h
--- /dev/null
+++ b/config.h
@@ -0,0 +1,121 @@
+#ifndef DAV1D_BAZEL_CONFIG_H_
+#define DAV1D_BAZEL_CONFIG_H_
+
+#define CONFIG_8BPC 1
+#define CONFIG_16BPC 1
+#define CONFIG_LOG 1
+#if defined(__linux__) && defined(__x86_64__)
+#define HAVE_ASM 1
+#else
+#define HAVE_ASM 0
+#endif
+#define TRIM_DSP_FUNCTIONS 0
+
+#if defined(_WIN32)
+#define HAVE_CLOCK_GETTIME 0
+#define HAVE_IO_H 1
+#define HAVE_POSIX_MEMALIGN 0
+#define HAVE_UNISTD_H 0
+#else
+#define HAVE_CLOCK_GETTIME 1
+#define HAVE_IO_H 0
+#define HAVE_POSIX_MEMALIGN 1
+#define HAVE_UNISTD_H 1
+#endif
+
+#define HAVE_ALIGNED_ALLOC 0
+#define HAVE_C11_GENERIC 1
+#define HAVE_DLSYM 0
+#define HAVE_ELF_AUX_INFO 0
+#define HAVE_GETAUXVAL 0
+#define HAVE_MEMALIGN 0
+#define HAVE_PTHREAD_GETAFFINITY_NP 0
+#define HAVE_PTHREAD_NP_H 0
+#define HAVE_PTHREAD_SETAFFINITY_NP 0
+#define HAVE_PTHREAD_SETNAME_NP 0
+#define HAVE_PTHREAD_SET_NAME_NP 0
+#define HAVE_SIGACTION 0
+#define HAVE_SYS_TYPES_H 1
+
+#define HAVE_AS_FUNC 0
+#define HAVE_AS_ARCH_DIRECTIVE 0
+#define HAVE_AS_ARCHEXT_DOTPROD_DIRECTIVE 0
+#define HAVE_AS_ARCHEXT_I8MM_DIRECTIVE 0
+#define HAVE_AS_ARCHEXT_SVE_DIRECTIVE 0
+#define HAVE_AS_ARCHEXT_SVE2_DIRECTIVE 0
+#define HAVE_DOTPROD 0
+#define HAVE_I8MM 0
+#define HAVE_SVE 0
+#define HAVE_SVE2 0
+
+#if defined(__x86_64__) || defined(_M_X64)
+#define ARCH_X86_64 1
+#else
+#define ARCH_X86_64 0
+#endif
+
+#if defined(__i386__) || defined(_M_IX86)
+#define ARCH_X86_32 1
+#else
+#define ARCH_X86_32 0
+#endif
+
+#define ARCH_X86 (ARCH_X86_64 || ARCH_X86_32)
+
+#if defined(__aarch64__) || defined(_M_ARM64)
+#define ARCH_AARCH64 1
+#else
+#define ARCH_AARCH64 0
+#endif
+
+#if defined(__arm__) || defined(_M_ARM)
+#define ARCH_ARM 1
+#else
+#define ARCH_ARM 0
+#endif
+
+#if defined(__powerpc64__) && defined(__LITTLE_ENDIAN__)
+#define ARCH_PPC64LE 1
+#else
+#define ARCH_PPC64LE 0
+#endif
+
+#if defined(__riscv)
+#define ARCH_RISCV 1
+#if __riscv_xlen == 32
+#define ARCH_RV32 1
+#define ARCH_RV64 0
+#else
+#define ARCH_RV32 0
+#define ARCH_RV64 1
+#endif
+#else
+#define ARCH_RISCV 0
+#define ARCH_RV32 0
+#define ARCH_RV64 0
+#endif
+
+#if defined(__loongarch__)
+#define ARCH_LOONGARCH 1
+#if __loongarch_grlen == 32
+#define ARCH_LOONGARCH32 1
+#define ARCH_LOONGARCH64 0
+#else
+#define ARCH_LOONGARCH32 0
+#define ARCH_LOONGARCH64 1
+#endif
+#else
+#define ARCH_LOONGARCH 0
+#define ARCH_LOONGARCH32 0
+#define ARCH_LOONGARCH64 0
+#endif
+
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define ENDIANNESS_BIG 1
+#else
+#define ENDIANNESS_BIG 0
+#endif
+
+#define PREFIX 0
+
+#endif
