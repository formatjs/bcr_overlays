load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"]))

cc_library(
    name = "headers",
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    deps = [":public_config_headers"],
)

cc_library(
    name = "chromium_headers",
    hdrs = glob(["**/*.h"]),
    include_prefix = "third_party/ffmpeg",
    strip_include_prefix = "/",
    deps = [":headers"],
)

cc_library(
    name = "public_config_headers",
    hdrs = glob(["chromium/config/Chromium/linux/x64/libavutil/*.h"]),
    strip_include_prefix = "chromium/config/Chromium/linux/x64",
)
