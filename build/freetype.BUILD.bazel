load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["src/**", "include/**", "builds/**"]))

cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h", "builds/**/*.h"]),
    textual_hdrs = glob(["src/**"], exclude = ["src/**/BUILD*", "src/**/MODULE.bazel"]),
    includes = ["include"],
)
