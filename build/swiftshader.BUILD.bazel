load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["**"], exclude = ["BUILD.bazel"]))

config_setting(name = "arm64", constraint_values = ["@platforms//cpu:aarch64"])

config_setting(name = "macos_arm64", constraint_values = ["@platforms//os:macos", "@platforms//cpu:aarch64"])

config_setting(name = "windows_arm64", constraint_values = ["@platforms//os:windows", "@platforms//cpu:aarch64"])

config_setting(name = "macos_x86_64", constraint_values = ["@platforms//os:macos", "@platforms//cpu:x86_64"])

config_setting(name = "windows_x86_64", constraint_values = ["@platforms//os:windows", "@platforms//cpu:x86_64"])

cc_library(
    name = "headers",
    hdrs = [p for p in glob([
        "src/**",
        "include/**",
        "third_party/subzero/**",
        "third_party/llvm-subzero/**",
        "third_party/marl/**",
        "third_party/astc-encoder/**",
    ], allow_empty = True) if p.endswith((".h", ".hpp", ".inc", ".inl", ".def", ".gen"))] + select({
        "@platforms//cpu:aarch64": [p for p in glob(["third_party/llvm-10.0/**"]) if p.endswith((".h", ".hpp", ".inc", ".inl", ".def", ".gen"))],
        "//conditions:default": [],
    }),
    include_prefix = "third_party/swiftshader",
    includes = [".", "src", "include", "third_party/marl/include", "third_party/astc-encoder/Source"] + select({
        ":macos_arm64": [
            "third_party/llvm-10.0/llvm/include",
            "third_party/llvm-10.0/llvm/lib/Target/AArch64",
            "third_party/llvm-10.0/llvm/lib/Target/ARM",
            "third_party/llvm-10.0/llvm/lib/Target/Mips",
            "third_party/llvm-10.0/llvm/lib/Target/PowerPC",
            "third_party/llvm-10.0/llvm/lib/Target/RISCV",
            "third_party/llvm-10.0/llvm/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/include",
            "third_party/llvm-10.0/configs/common/lib/IR",
            "third_party/llvm-10.0/configs/common/lib/Target/AArch64",
            "third_party/llvm-10.0/configs/common/lib/Target/ARM",
            "third_party/llvm-10.0/configs/common/lib/Target/Mips",
            "third_party/llvm-10.0/configs/common/lib/Target/PowerPC",
            "third_party/llvm-10.0/configs/common/lib/Target/RISCV",
            "third_party/llvm-10.0/configs/common/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/lib/Transforms/InstCombine",
            "third_party/llvm-10.0/configs/darwin/include",
        ],
        ":windows_arm64": [
            "third_party/llvm-10.0/llvm/include",
            "third_party/llvm-10.0/llvm/lib/Target/AArch64",
            "third_party/llvm-10.0/llvm/lib/Target/ARM",
            "third_party/llvm-10.0/llvm/lib/Target/Mips",
            "third_party/llvm-10.0/llvm/lib/Target/PowerPC",
            "third_party/llvm-10.0/llvm/lib/Target/RISCV",
            "third_party/llvm-10.0/llvm/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/include",
            "third_party/llvm-10.0/configs/common/lib/IR",
            "third_party/llvm-10.0/configs/common/lib/Target/AArch64",
            "third_party/llvm-10.0/configs/common/lib/Target/ARM",
            "third_party/llvm-10.0/configs/common/lib/Target/Mips",
            "third_party/llvm-10.0/configs/common/lib/Target/PowerPC",
            "third_party/llvm-10.0/configs/common/lib/Target/RISCV",
            "third_party/llvm-10.0/configs/common/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/lib/Transforms/InstCombine",
            "third_party/llvm-10.0/configs/windows/include",
        ],
        ":arm64": [
            "third_party/llvm-10.0/llvm/include",
            "third_party/llvm-10.0/llvm/lib/Target/AArch64",
            "third_party/llvm-10.0/llvm/lib/Target/ARM",
            "third_party/llvm-10.0/llvm/lib/Target/Mips",
            "third_party/llvm-10.0/llvm/lib/Target/PowerPC",
            "third_party/llvm-10.0/llvm/lib/Target/RISCV",
            "third_party/llvm-10.0/llvm/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/include",
            "third_party/llvm-10.0/configs/common/lib/IR",
            "third_party/llvm-10.0/configs/common/lib/Target/AArch64",
            "third_party/llvm-10.0/configs/common/lib/Target/ARM",
            "third_party/llvm-10.0/configs/common/lib/Target/Mips",
            "third_party/llvm-10.0/configs/common/lib/Target/PowerPC",
            "third_party/llvm-10.0/configs/common/lib/Target/RISCV",
            "third_party/llvm-10.0/configs/common/lib/Target/X86",
            "third_party/llvm-10.0/configs/common/lib/Transforms/InstCombine",
            "third_party/llvm-10.0/configs/linux/include",
        ],
        ":macos_x86_64": [
            "third_party/subzero",
            "third_party/subzero/pnacl-llvm/include",
            "third_party/llvm-subzero/build/MacOS/include",
            "third_party/llvm-subzero/include",
        ],
        ":windows_x86_64": [
            "third_party/subzero",
            "third_party/subzero/pnacl-llvm/include",
            "third_party/llvm-subzero/build/Windows/include",
            "third_party/llvm-subzero/include",
        ],
        "//conditions:default": [
            "third_party/subzero",
            "third_party/subzero/pnacl-llvm/include",
            "third_party/llvm-subzero/build/Linux/include",
            "third_party/llvm-subzero/include",
        ],
    }),
)
