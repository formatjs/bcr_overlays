load("@chromium//build:buildflag_header.bzl", "buildflag_header")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

exports_files(glob(
    ["bcr/*"],
    exclude = ["**/BUILD.bazel"],
))

buildflag_header(
    name = "test_buildflags",
    flags = {
        "ENABLED": "true",
        "DISABLED": "false",
        "COUNT": "7",
        "LABEL": "\"chromium\"",
    },
    header = "tests/generated_buildflags.h",
)

cc_test(
    name = "native_foundation_test",
    size = "small",
    srcs = ["tests/native_foundation_test.cc"],
    copts = ["-std=c++17"],
    deps = [
        ":test_buildflags",
        "@chromium//base/third_party/cityhash",
        "@chromium//base/third_party/double_conversion",
        "@chromium//base/third_party/icu:icu_utf",
        "@chromium//build:build_config",
        "@chromium//third_party/modp_b64",
        "@googletest//:gtest_main",
    ],
)

filegroup(
    name = "foundation",
    srcs = ["@chromium//:foundation"],
)
