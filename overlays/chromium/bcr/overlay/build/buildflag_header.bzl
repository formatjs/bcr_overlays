"""Generate Chromium build flags with native Bazel actions."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

def _identifier(value):
    letters = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_"
    digits = "0123456789"
    return bool(value) and value[0] in letters and all([c in letters + digits for c in value.elems()])

def _header_impl(ctx):
    lines = [
        "// Generated by buildflag_header.",
        "#pragma once",
        '#include "build/buildflag.h"',
        "",
    ]
    for key, value in sorted(ctx.attr.flags.items()):
        if not _identifier(key):
            fail("invalid build flag identifier: " + key)
        if "\n" in value or "\r" in value:
            fail("build flag values must be single-line C++ expressions")
        value = {"true": "1", "false": "0"}.get(value, value)
        lines.append("#define BUILDFLAG_INTERNAL_%s() (%s)" % (key, value))
    ctx.actions.write(ctx.outputs.header, "\n".join(lines) + "\n")
    return [DefaultInfo(files = depset([ctx.outputs.header]))]

_header = rule(
    implementation = _header_impl,
    attrs = {
        "flags": attr.string_dict(mandatory = True),
        "header": attr.output(mandatory = True),
    },
)

def buildflag_header(name, header, flags, visibility = None, **kwargs):
    """Expose generated flags as a C++ dependency; values are C++ expressions."""
    _header(
        name = name + "_header",
        header = header,
        flags = flags,
        visibility = ["//visibility:private"],
    )
    cc_library(
        name = name,
        hdrs = [":" + name + "_header"],
        deps = [Label("//build:buildflag")],
        visibility = visibility,
        **kwargs
    )
