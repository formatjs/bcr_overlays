diff --git a/overlays/chromium/bcr/overlay/native/qt_sdk_headers.bzl b/overlays/chromium/bcr/overlay/native/qt_sdk_headers.bzl
new file mode 100644
--- /dev/null
+++ b/overlays/chromium/bcr/overlay/native/qt_sdk_headers.bzl
@@ -0,0 +1,33 @@
+"""Keep Qt on the captured SDK's GNU C++ headers and runtime."""
+
+load("@rules_cc//cc:find_cc_toolchain.bzl", "find_cpp_toolchain", "use_cc_toolchain")
+load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+def _qt_sdk_headers_impl(ctx):
+    toolchain = find_cpp_toolchain(ctx)
+    resources = [file for file in toolchain.all_files.to_list() if "/lib/clang/" in file.path and "/" not in file.path.split("/lib/clang/", 1)[1]]
+    if len(resources) != 1:
+        fail("Qt SDK profile needs one Clang resource directory from the selected toolchain")
+    root = ctx.attr.sdk.label.workspace_root
+    headers = ctx.attr.sdk[CcInfo].compilation_context.headers
+    return [CcInfo(
+        compilation_context = cc_common.create_compilation_context(
+            headers = headers,
+            includes = depset([
+                root + "/usr/include/c++/10",
+                root + "/usr/include/x86_64-linux-gnu/c++/10",
+                resources[0].path + "/include",
+                root + "/usr/include/x86_64-linux-gnu",
+                root + "/usr/include",
+            ], order = "preorder"),
+        ),
+        linking_context = ctx.attr.sdk[CcInfo].linking_context,
+    )]
+
+chromium_qt_sdk_headers = rule(
+    implementation = _qt_sdk_headers_impl,
+    attrs = {"sdk": attr.label(mandatory = True, providers = [CcInfo])},
+    fragments = ["cpp"],
+    toolchains = use_cc_toolchain(),
+)
diff --git a/overlays/chromium/bcr/overlay/native/runtime_bundle.bzl b/overlays/chromium/bcr/overlay/native/runtime_bundle.bzl
new file mode 100644
--- /dev/null
+++ b/overlays/chromium/bcr/overlay/native/runtime_bundle.bzl
@@ -0,0 +1,46 @@
+"""Assemble declared Chromium and platform runtime files."""
+
+load(":python_action.bzl", "ChromiumFilesInfo")
+
+def _runtime_bundle_impl(ctx):
+    files = {}
+    for target, logical in ctx.attr.srcs.items():
+        sources = target[DefaultInfo].files.to_list()
+        if len(sources) != 1:
+            fail("runtime source must identify one file: %s" % target.label)
+        if logical in files and files[logical] != sources[0]:
+            fail("conflicting runtime path: " + logical)
+        files[logical] = sources[0]
+    for dependency in ctx.attr.deps:
+        for source, path in dependency[ChromiumFilesInfo].mappings.to_list():
+            prefix = "out/bazel-import/"
+            if not path.startswith(prefix):
+                fail("runtime dependency lacks a build-relative path: " + path)
+            logical = path[len(prefix):]
+            if logical in files and files[logical] != source:
+                fail("conflicting runtime path: " + logical)
+            files[logical] = source
+    output = ctx.actions.declare_directory(ctx.label.name)
+    manifest = ctx.actions.declare_file(ctx.label.name + ".runtime.json")
+    ctx.actions.write(manifest, json.encode({
+        "inputs": [[files[path].path, path] for path in sorted(files)],
+        "output": output.path,
+    }))
+    ctx.actions.run(
+        executable = ctx.attr._runner[DefaultInfo].files_to_run,
+        arguments = [manifest.path],
+        inputs = depset([manifest] + files.values()),
+        outputs = [output],
+        mnemonic = "ChromiumRuntimeBundle",
+        progress_message = "Assembling %s" % ctx.label,
+    )
+    return [DefaultInfo(files = depset([output]))]
+
+chromium_runtime_bundle = rule(
+    implementation = _runtime_bundle_impl,
+    attrs = {
+        "srcs": attr.label_keyed_string_dict(allow_files = True),
+        "deps": attr.label_list(providers = [ChromiumFilesInfo]),
+        "_runner": attr.label(default = Label("//native:runtime_bundle_runner"), executable = True, cfg = "exec"),
+    },
+)
diff --git a/overlays/chromium/bcr/overlay/native/assemble_runtime.py b/overlays/chromium/bcr/overlay/native/assemble_runtime.py
new file mode 100644
--- /dev/null
+++ b/overlays/chromium/bcr/overlay/native/assemble_runtime.py
@@ -0,0 +1,42 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Copy declared runtime files into a relocatable bundle."""
+
+import argparse
+import json
+from pathlib import Path, PurePosixPath
+import shutil
+
+
+def assemble(manifest):
+    files = {}
+    for actual, logical in manifest['inputs']:
+        relative = PurePosixPath(logical)
+        if relative.is_absolute() or '..' in relative.parts or not relative.parts:
+            raise ValueError(f'invalid runtime path: {logical}')
+        normalized = str(relative)
+        if normalized in files:
+            raise ValueError(f'duplicate runtime path: {normalized}')
+        source = Path(actual)
+        if not source.is_file():
+            raise FileNotFoundError(f'missing runtime input: {source}')
+        files[normalized] = source
+    output = Path(manifest['output'])
+    output.mkdir(parents=True, exist_ok=True)
+    if any(output.iterdir()):
+        raise ValueError(f'runtime output must be empty: {output}')
+    for logical, source in sorted(files.items()):
+        destination = output / logical
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(source, destination)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('manifest', type=Path)
+    args = parser.parse_args()
+    assemble(json.loads(args.manifest.read_text()))
+
+
+if __name__ == '__main__':
+    main()
