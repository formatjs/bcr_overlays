load("//native:host_support.bzl", cc_library = "platform_cc_library")
load(":sources.bzl", "COPTS", "DEFINES", "HEADERS", "SOURCES")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "headers",
    hdrs = HEADERS,
    defines = DEFINES,
    includes = [".."],
    target_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    deps = ["//native:partition_alloc_buildflags"],
)

cc_library(
    name = "allocator_base",
    srcs = SOURCES["allocator_base"],
    copts = COPTS["allocator_base"] if type(COPTS) == "dict" else COPTS,
    features = [
        "static_link_msvcrt",
        "-dynamic_link_msvcrt",
    ],
    linkopts = ["winmm.lib"],
    local_defines = ["IS_PARTITION_ALLOC_BASE_IMPL"],
    deps = [":headers"],
)

cc_library(
    name = "allocator_core",
    srcs = SOURCES["allocator_core"],
    copts = COPTS["allocator_core"] if type(COPTS) == "dict" else COPTS,
    features = [
        "static_link_msvcrt",
        "-dynamic_link_msvcrt",
    ],
    local_defines = ["IS_PARTITION_ALLOC_IMPL"],
    deps = [":allocator_base"],
)

cc_library(
    name = "allocator_shim",
    srcs = SOURCES["allocator_shim"],
    copts = COPTS["allocator_shim"] if type(COPTS) == "dict" else COPTS,
    features = [
        "static_link_msvcrt",
        "-dynamic_link_msvcrt",
    ],
    local_defines = ["IS_ALLOCATOR_SHIM_IMPL"],
    deps = [":allocator_core"],
    alwayslink = True,
)

cc_library(
    name = "raw_ptr",
    srcs = SOURCES["raw_ptr"],
    copts = COPTS["raw_ptr"] if type(COPTS) == "dict" else COPTS,
    features = [
        "static_link_msvcrt",
        "-dynamic_link_msvcrt",
    ],
    local_defines = ["IS_RAW_PTR_IMPL"],
    deps = [":allocator_shim"],
)

cc_library(
    name = "partition_alloc",
    deps = [
        ":allocator_shim",
        ":raw_ptr",
    ],
)

exports_files([
    "BUILD.bazel",
    "sources.bzl",
    "write_buildflag_header.py",
])

