load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":chromium_sources.bzl", "COPTS", "DEFINES", "HEADERS", "SOURCES")

cc_library(
    name = "ced",
    srcs = SOURCES,
    hdrs = HEADERS,
    copts = COPTS,
    includes = ["."],
    linkstatic = True,
    local_defines = DEFINES,
    visibility = ["//visibility:public"],
)

exports_files(["LICENSE"])

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "windows_amd64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)
