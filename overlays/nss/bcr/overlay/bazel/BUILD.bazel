load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load(":actions.bzl", "sign_runtime")

exports_files([
    "actions.bzl",
    "nss.bzl",
    "sources.bzl",
    "sources_arm64.bzl",
])

py_binary(
    name = "mapfile_generator",
    srcs = ["generate.py"],
    main = "generate.py",
    visibility = ["//visibility:public"],
)

py_binary(
    name = "sign_driver",
    srcs = ["sign.py"],
    main = "sign.py",
    visibility = ["//visibility:public"],
)

sign_runtime(
    name = "sign_replay_inputs",
    tool = "//:shlibsign",
)

py_test(
    name = "sign_test",
    size = "small",
    srcs = [
        "sign.py",
        "sign_test.py",
    ],
    args = [
        "$(rlocationpaths :sign_replay_inputs)",
        "$(rlocationpath //:libfreebl3.so)",
    ],
    data = [
        ":sign_replay_inputs",
        "//:libfreebl3.so",
    ],
    imports = ["."],
    main = "sign_test.py",
    visibility = ["//visibility:public"],
    deps = ["@rules_python//python/runfiles"],
)
