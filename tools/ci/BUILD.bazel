    "darwin_arm64_browser",
    "linux_amd64_browser",
    "linux_arm64_browser",
    "windows_amd64_browser",
    "windows_arm64_browser",
)

package(default_visibility = ["//visibility:public"])

linux_amd64_browser(
    name = "linux-amd64",
    srcs = ["@chromium//native:browser_bundle"],
)

