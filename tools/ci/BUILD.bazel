load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load(":archive.bzl", "chromium_archive")
load(
    ":browser_targets.bzl",
    "darwin_arm64_browser",
    "linux_amd64_browser",
    "linux_arm64_browser",
    "msvc_static_crt",
    "windows_amd64_browser",
    "windows_arm64_browser",
)

package(default_visibility = ["//visibility:public"])

linux_amd64_browser(
    name = "linux-amd64",
    srcs = ["@chromium//native:browser_bundle"],
)

linux_arm64_browser(
    name = "linux-arm64",
    srcs = ["@chromium_linux_arm64//native:browser_bundle"],
)

darwin_arm64_browser(
    name = "darwin-arm64",
    srcs = ["@chromium//native:browser_bundle"],
)

windows_amd64_browser(
    name = "windows-amd64",
    srcs = ["@chromium//native:browser_bundle"],
)

windows_arm64_browser(
    name = "windows-arm64",
    srcs = ["@chromium//native:browser_bundle"],
)

string_flag(
    name = "revision",
    build_setting_default = "",
)

cc_binary(
    name = "windows_allocator_probe",
    srcs = ["allocator_probe.cc"],
    copts = [
        "/std:c++20",
        "/EHs-c-",
    ],
    features = [
        "static_link_msvcrt",
        "-dynamic_link_msvcrt",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    deps = select({
        "@platforms//cpu:x86_64": ["@chromium_windows_amd64//base/allocator/partition_allocator/src/partition_alloc:allocator_core"],
        "@platforms//cpu:aarch64": ["@chromium_windows_arm64//base/allocator/partition_allocator/src/partition_alloc:allocator_core"],
    }),
)

cc_binary(
    name = "darwin_allocator_probe",
    srcs = ["allocator_probe.cc"],
    copts = [
        "-std=c++20",
        "-fno-exceptions",
    ],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ["@chromium_darwin_arm64//base/allocator/partition_allocator/src/partition_alloc:allocator_core"],
)

darwin_arm64_browser(
    name = "allocator-darwin-arm64",
    srcs = [":darwin_allocator_probe"],
)

windows_amd64_browser(
    name = "allocator-windows-amd64",
    srcs = [":allocator_static_crt"],
)

windows_arm64_browser(
    name = "allocator-windows-arm64",
    srcs = [":allocator_static_crt"],
)

msvc_static_crt(
    name = "allocator_static_crt",
    srcs = [":windows_allocator_probe"],
)

exports_files([
    "chromium.py",
    "platforms.json",
])

chromium_archive(
    name = "linux-amd64_archive",
    bundle = ":linux-amd64",
    platform = "linux-amd64",
)

chromium_archive(
    name = "linux-arm64_archive",
    bundle = ":linux-arm64",
    platform = "linux-arm64",
)

chromium_archive(
    name = "darwin-arm64_archive",
    bundle = ":darwin-arm64",
    platform = "darwin-arm64",
)

chromium_archive(
    name = "windows-amd64_archive",
    bundle = ":windows-amd64",
    platform = "windows-amd64",
)

chromium_archive(
    name = "windows-arm64_archive",
    bundle = ":windows-arm64",
    platform = "windows-arm64",
)

rust_binary(
    name = "rust_toolchain_probe",
    srcs = ["rust_toolchain_probe.rs"],
    edition = "2021",
)

linux_amd64_browser(
    name = "rust-linux-amd64",
    srcs = [":rust_toolchain_probe"],
)

linux_arm64_browser(
    name = "rust-linux-arm64",
    srcs = [":rust_toolchain_probe"],
)

darwin_arm64_browser(
    name = "rust-darwin-arm64",
    srcs = [":rust_toolchain_probe"],
)

windows_amd64_browser(
    name = "rust-windows-amd64",
    srcs = [":rust_toolchain_probe"],
)

windows_arm64_browser(
    name = "rust-windows-arm64",
    srcs = [":rust_toolchain_probe"],
)

cc_binary(
    name = "expat_toolchain_probe",
    srcs = ["expat_toolchain_probe.c"],
    deps = ["@libexpat"],
)

linux_amd64_browser(
    name = "expat-linux-amd64",
    srcs = [":expat_toolchain_probe"],
)

linux_arm64_browser(
    name = "expat-linux-arm64",
    srcs = [":expat_toolchain_probe"],
)

darwin_arm64_browser(
    name = "expat-darwin-arm64",
    srcs = [":expat_toolchain_probe"],
)

windows_amd64_browser(
    name = "expat-windows-amd64",
    srcs = [":expat_toolchain_probe"],
)

windows_arm64_browser(
    name = "expat-windows-arm64",
    srcs = [":expat_toolchain_probe"],
)
